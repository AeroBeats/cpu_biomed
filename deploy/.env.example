# 复制成 .env 后填写。.env 含明文口令，不要提交进版本库、不要发给任何人。
# chmod 600 .env

# ---- 管理员账号 ----
# 服务启动时会把这个账号写进数据库的 app_users 表，角色是 admin。
# 用它登录站点后，导航里会自动出现「内容管理」，可以改题库、考纲和背诵卡。
# 口令至少 8 位，且只能是字母和数字（openssl rand -hex 24 正好满足），否则服务拒绝启动。
# 改这里的口令再重启服务，管理员口令会跟着同步；账号不会被锁在外面。
ADMIN_USER=owner
ADMIN_PASSWORD=用 openssl rand -hex 24 生成

# ---- 会话签名密钥（可选）----
# 留空就从 ADMIN_PASSWORD 派生，够用；代价是改管理员口令会让所有已登录的人重新登录一次。
# 想让「改口令」和「踢下线」互不影响，就单独填一个（openssl rand -hex 32）。
# 换掉这个值同样会让现有会话全部失效。
SESSION_SECRET=

# ---- PostgreSQL ----
# 口令只用十六进制字符（openssl rand -hex 24）。
# 不要用 base64：它会产生 + / = 这些字符，拼进 DATABASE_URL 连接串会被解析错。
POSTGRES_DB=cpubiomed
POSTGRES_USER=cpubiomed
POSTGRES_PASSWORD=用 openssl rand -hex 24 生成

# ---- 对外端口 ----
# 只暴露 nginx；api 与 db 不映射到宿主机。
HTTP_PORT=80

# ---- 题库配图（不用在这里配）----
# 后台插图存到 MEDIA_DIR，两条路线都已写死、不需要你填：
#   原生部署 → install.sh 自动写 /opt/cpubiomed/media（755，service 用户可写、nginx 可读）
#   Docker   → docker-compose.yml 里的 mediadata 卷，容器内 /app/media
# 只有手动 node deploy/server/index.mjs 跑服务时才需要自己 export MEDIA_DIR=/some/path；
# 不设的话服务照样启动，只是上传接口会回 upload_unavailable。
# 单张图上限 2 MB，只收 png / jpg / gif / webp（SVG 会被拒，它能内嵌脚本）。
