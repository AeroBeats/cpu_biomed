# 复制成 .env 后填写。.env 含明文口令，不要提交进版本库、不要发给任何人。
# chmod 600 .env

# ---- 站点访问口令（HTTP Basic）----
# 打开站点时会弹出登录框，填这两个值。整个站点（页面 + 题库接口）都在这个口令之后。
# 口令至少 8 位，否则服务拒绝启动。
ADMIN_USER=owner
ADMIN_PASSWORD=用 openssl rand -hex 24 生成

# ---- PostgreSQL ----
# 口令只用十六进制字符（openssl rand -hex 24）。
# 不要用 base64：它会产生 + / = 这些字符，拼进 DATABASE_URL 连接串会被解析错。
POSTGRES_DB=cpubiomed
POSTGRES_USER=cpubiomed
POSTGRES_PASSWORD=用 openssl rand -hex 24 生成

# ---- 对外端口 ----
# 只暴露 nginx；api 与 db 不映射到宿主机。
HTTP_PORT=80
